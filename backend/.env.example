# Copy this file to .env and fill in your real values

# MySQL connection (matches Schema1.sql -> medicine_store database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medicine_store

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# In production, NODE_ENV should be "production" so password-reset tokens
# are never echoed back in API responses (see auth.routes.js).
NODE_ENV=development
